# ============================================================================
# 1. تنظیمات تلگرام (الزامی)
# ============================================================================
# توکن ربات که از @BotFather گرفته‌اید:
TELEGRAM_BOT_TOKEN=1234567890:AAH_YOUR_BOT_TOKEN_HERE
# آیدی عددی اکانت تلگرام خودتان (از @userinfobot بگیرید):
TELEGRAM_ADMIN_CHAT_ID=123456789
# در صورت فیلتر بودن تلگرام روی سیستم شما (ویندوز ایران)، آدرس پروکسی را وارد کنید:
# مثال برای v2rayN: socks5://127.0.0.1:10808 یا http://127.0.0.1:10809
# روی سرور خارج (Coolify) خالی بگذارید:
TELEGRAM_PROXY_URL=

# ============================================================================
# 2. هوش مصنوعی گوگل جمینای (الزامی)
# ============================================================================
# کلید رایگان دریافت‌شده از https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
# مدل پیش‌فرض: gemini-3.8-flash | گزینه‌های دیگر: gemini-3.8-pro | gemini-3.5-flash | gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash
AI_MIN_CONFIDENCE=70
AI_MAX_CALLS_PER_DAY=45
AI_MIN_INTERVAL_SEC=900
AI_TEMPERATURE=0.2

# ============================================================================
# 3. حالت اجرا و صرافی
# ============================================================================
# True = حالت شبیه‌ساز (بدون پول واقعی، کاملاً امن برای تست)
# False = معامله واقعی با پول داخل صرافی
DRY_RUN=True
STARTING_BALANCE=10.0
MIN_BALANCE_TO_TRADE=3.0

# صرافی معاملاتی: lbank | binance | bybit
EXCHANGE_ID=lbank
# صرافی دریافت کندل‌ها (اگر خالی باشد از همان EXCHANGE_ID استفاده می‌شود؛
# می‌توانید مثلاً برای کندل‌های دقیق‌تر بگذارید binance یا bybit):
MARKET_DATA_EXCHANGE_ID=
SYMBOL=BTC/USDT:USDT

# کلیدهای صرافی (در حالت DRY_RUN=True می‌توانید خالی بگذارید):
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
EXCHANGE_PROXY_URL=
USE_TESTNET=False

# ============================================================================
# 4. قوانین مدیریت ریسک و سرمایه (فرمول حساب ۱۰ دلاری)
# ============================================================================
RISK_PER_TRADE_PCT=0.04
DAILY_PROFIT_TARGET_USD=1.0
DAILY_PROFIT_TARGET_PCT=0.10
DAILY_MAX_LOSS_USD=0.80
DAILY_MAX_LOSS_PCT=0.08
MAX_CONSECUTIVE_LOSSES=2
CIRCUIT_BREAKER_HOURS=24

MIN_LEVERAGE=10
MAX_LEVERAGE=35
MAX_MARGIN_USAGE=0.90
MAINTENANCE_MARGIN_RATE=0.005
LIQUIDATION_BUFFER=1.5

MIN_RR=2.0
TP1_RR=1.5
TP1_CLOSE_FRACTION=0.50
MIN_SL_PCT=0.0012
MAX_SL_PCT=0.0120

MAKER_FEE=0.0002
TAKER_FEE=0.0006
SLIPPAGE_PCT=0.0002
BREAKEVEN_BUFFER_PCT=0.0

# ============================================================================
# 5. اجرای سفارش و تریلینگ استاپ
# ============================================================================
ENTRY_POST_ONLY=True
ENTRY_TIMEOUT_MIN=5
MAX_ENTRY_DEVIATION_PCT=0.003

# روش تریلینگ استاپ: hybrid | atr | ema
TRAILING_METHOD=hybrid
TRAILING_ATR_MULT=1.5
TRAILING_TIGHT_ATR_MULT=0.8
TRAILING_EMA_BUFFER_ATR=0.25
TRAIL_MIN_STEP_PCT=0.0005
CLOSE_AT_TP2=False

# ============================================================================
# 6. تایم‌فریم‌ها و اندیکاتورها
# ============================================================================
TF_TREND=15m
TF_ENTRY=1m
OHLCV_LIMIT=300

EMA_FAST=9
EMA_SLOW=26
RSI_PERIOD=14
ATR_PERIOD=14
PULLBACK_ATR_MULT=0.35
SR_PROXIMITY_ATR=0.40
RSI_OVERSOLD=35
RSI_OVERBOUGHT=65
MOMENTUM_BODY_ATR=0.40

# ============================================================================
# 7. زمان‌بندی حلقه‌ها و تنظیمات عمومی
# ============================================================================
SCAN_INTERVAL_SEC=20
MONITOR_INTERVAL_SEC=3
TRAIL_REFRESH_SEC=20
LIVE_SYNC_SEC=10

DATA_DIR=./data
LOG_LEVEL=INFO
NOTIFY_AI_WAIT=True
DISPLAY_TIMEZONE=Asia/Tehran
